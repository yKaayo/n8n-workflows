arameters":{"chatId":"={{ $('Normalize Input').first().json.chat_id }}","text":"={{ $json.text }}","additionalFields":{}},"type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[672,192],"id":"88919d24-bb4e-4838-b71f-c1aea10f14cc","name":"Send a text message","webhookId":"38c4c4fb-0a12-48ef-87d4-afb61c4ce546","credentials":{"telegramApi":{"id":"ztAD0PBKSFJsJxc1","name":"ParaOndeFoiMeuDinheiro?"}}},{"parameters":{"operation":"executeQuery","query":"WITH periodo AS (\n  SELECT date_trunc('month', CURRENT_DATE) - ({{ $json.months }} || ' months')::interval AS inicio,\n         date_trunc('month', CURRENT_DATE) - ({{ $json.months }} || ' months')::interval + interval '1 month' AS fim\n),\nanterior AS (\n  SELECT inicio - interval '1 month' AS inicio, inicio AS fim FROM periodo\n)\nSELECT\n  {{ $json.months }} AS months,\n  (SELECT COALESCE(SUM(amount),0) FROM expenses_bot_telegram, periodo\n     WHERE user_id = {{ $('Resolve Conversation').item.json.user_id }} AND expense_date >= periodo.inicio AND expense_date < periodo.fim) AS total_periodo,\n  (SELECT COALESCE(SUM(amount),0) FROM expenses_bot_telegram, anterior\n     WHERE user_id = {{ $('Resolve Conversation').item.json.user_id }} AND expense_date >= anterior.inicio AND expense_date < anterior.fim) AS total_anterior;","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[0,192],"id":"91089077-be88-4446-a657-113dbeb41029","name":"Get Mounth Expenses","credentials":{"postgres":{"id":"LNvDw91EFKXdsTw3","name":"POSTGRES_N8N_DOCKER"}}},{"parameters":{"jsCode":"const linhas = $input.all()\n  .filter(i => i.json.id !== undefined)\n  .map(i => ([{ text: i.json.name, callback_data: String(i.json.id) }]));\n\nreturn [{ json: { chat_id: $('Normalize Input').first().json.chat_id, text: 'Escolha a categoria:', reply_markup: { inline_keyboard: linhas } } }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[224,560],"id":"1f49cb01-2cd5-4646-a416-78910faab65d","name":"Normalize Categories for Telegram1"},{"parameters":{"operation":"executeQuery","query":"UPDATE telegram_conversations\nSET current_step = 'awaiting_category_filter'\nWHERE id = {{ $('Resolve Conversation').item.json.id }};","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[-224,560],"id":"faac4497-91d9-49b5-95e4-631784156487","name":"Update to Find User Categories","alwaysOutputData":true,"credentials":{"postgres":{"id":"LNvDw91EFKXdsTw3","name":"POSTGRES_N8N_DOCKER"}}},{"parameters":{"operation":"executeQuery","query":"SELECT id, name FROM categories_bot_telegram WHERE id = {{ $('Normalize Input').first().json.text }} AND user_id = {{ $json.user_id }};","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[0,1056],"id":"920b4bc2-c942-47b5-aeef-9574557068bb","name":"Valid if the Category Belongs User","credentials":{"postgres":{"id":"LNvDw91EFKXdsTw3","name":"POSTGRES_N8N_DOCKER"}}},{"parameters":{"operation":"executeQuery","query":"WITH primeiro AS (\n  SELECT MIN(expense_date) AS primeira_data\n  FROM expenses_bot_telegram\n  WHERE user_id = {{ $('Resolve Conversation').item.json.user_id }}\n    AND category_id = {{ $json.id }}\n),\nmeses AS (\n  SELECT GREATEST(\n    1,\n    ((EXTRACT(YEAR FROM age(date_trunc('month', CURRENT_DATE), date_trunc('month', COALESCE(primeira_data, CURRENT_DATE)))) * 12)\n     + EXTRACT(MONTH FROM age(date_trunc('month', CURRENT_DATE), date_trunc('month', COALESCE(primeira_data, CURRENT_DATE)))) + 1)::int\n  ) AS qtd_meses\n  FROM primeiro\n)\nSELECT\n  COALESCE(SUM(e.amount) FILTER (WHERE e.expense_date >= date_trunc('month', CURRENT_DATE)), 0) AS total_mes_atual,\n  COALESCE(SUM(e.amount) FILTER (WHERE e.expense_date >= date_trunc('month', CURRENT_DATE) - interval '3 months'), 0)\n    / LEAST(3, m.qtd_meses) AS media_3_meses,\n  COALESCE(SUM(e.amount) FILTER (WHERE e.expense_date >= date_trunc('month', CURRENT_DATE) - interval '12 months'), 0)\n    / LEAST(12, m.qtd_meses) AS media_1_ano\nFROM meses m\nLEFT JOIN expenses_bot_telegram e\n  ON e.user_id = {{ $('Resolve Conversation').item.json.user_id }}\n  AND e.category_id = {{ $json.id }}\nGROUP BY m.qtd_meses;","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[224,1056],"id":"1ff2c822-65e6-450c-82a0-ab7b8c4042b3","name":"Get Data by Category","credentials":{"postgres":{"id":"LNvDw91EFKXdsTw3","name":"POSTGRES_N8N_DOCKER"}}},{"parameters":{"jsCode":"const totais = $input.first().json; // troque 'Node B' pelo nome real do node da query de totais\nconst categoria = $('Valid if the Category Belongs User').first().json.name\n\nconst total_mes = Number(totais.total_mes_atual);\nconst media_3 = Number(totais.media_3_meses);\nconst media_ano = Number(totais.media_1_ano);\n\nconst variacao = media_3 > 0 ? ((total_mes - media_3) / media_3 * 100) : null;\nconst seta = variacao === null ? '' : (variacao >= 0 ? `📈 +${variacao.toFixed(0)}%` : `📉 ${variacao.toFixed(0)}%`);\n\nconst texto = `📂 ${categoria}\\n\\n` +\n  `Este mês: R$ ${total_mes.toFixed(2)} ${seta ? `(${seta} vs média de 3 meses)` : ''}\\n` +\n  `Média (últimos 3 meses): R$ ${media_3.toFixed(2)}\\n` +\n  `Média (últimos 12 meses): R$ ${media_ano.toFixed(2)}`;\n\nreturn [{ json: { text: texto } }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[448,1056],"id":"f209eabf-5ad7-4f0d-99fa-c3d47d49d0e8","name":"Normalize Category Data Message"},{"parameters":{"jsCode":"const totais = $('Get Mounth Expenses').first().json;\nconst data = $input.all().map(i => i.json); \n\nconst total = Number(totais.total_periodo);\nconst anterior = Number(totais.total_anterior);\nconst variacao = anterior > 0 ? ((total - anterior) / anterior * 100) : null;\nconst seta = variacao === null ? '' : (variacao >= 0 ? `📈 +${variacao.toFixed(0)}%` : `📉 ${variacao.toFixed(0)}%`);\n\nconst linhas = data.map(c => {\n  const pct = total > 0 ? (Number(c.total) / total * 100).toFixed(0) : 0;\n  return `- ${c.categoria}: R$ ${Number(c.total).toFixed(2)} (${pct}%)`;\n}).join('\\n');\n\nconst texto = `Total: R$ ${total.toFixed(2)} ${seta ? `vs mês anterior (${seta})` : ''}\\n\\n${linhas || 'Nenhum gasto nesse período.'}`;\n\nreturn [{ json: { text: texto } }];"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[448,192],"id":"6601840d-8313-492c-9389-1eb98ae97fd0","name":"Normalize Period Data Message"},{"parameters":{"operation":"executeQuery","query":"SELECT c.name AS categoria, SUM(e.amount) AS total, COUNT(*) AS qtd\nFROM expenses_bot_telegram e\nJOIN categories_bot_telegram c ON c.id = e.category_id\nCROSS JOIN (\n  SELECT date_trunc('month', CURRENT_DATE) - ({{ $json.months }} || ' months')::interval AS inicio,\n         date_trunc('month', CURRENT_DATE) - ({{ $json.months }} || ' months')::interval + interval '1 month' AS fim\n) periodo\nWHERE e.user_id = {{ $('Resolve Conversation').item.json.user_id }}\n  AND e.expense_date >= periodo.inicio AND e.expense_date < periodo.fim\nGROUP BY c.name\nORDER BY total DESC;","options":{}},"type":"n8n-nodes-base.postgres","typeVersion":2.6,"position":[224,192],"id":"b095a9c4-22a1-4fe5-8d8e-dde9ba2979dd","name":"Get Data by the Same Period","credentials":{"postgres":{"id":"LNvDw91EFKXdsTw3","name":"POSTGRES_N8N_DOCKER"}}},{"parameters":{"chatId":"={{ $('Normalize Input').item.json.chat_id }}","text":"Selecione uma das opções:","additionalFields":{}},"type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[-224,752],"id":"f6f20a21-94df-4c26-bca4-d28f58d8e836","name":"Advice the User to Choose Again","webhookId":"66a2aeb4-fd26-4fb2-b32f-4721ce50ddb6","credentials":{"telegramApi":{"id":"ztAD0PBKSFJsJxc1","name":"ParaOndeFoiMeuDinheiro?"}}},{"parameters":{"operation":"select","schema":{"__rl":true,"mode":"list","value":"public"},"table":{"__rl":true,"value":"categories_bot_telegram","mode":"list","cachedResultName":"categories_bot_telegram"},"where":{"values":[{"column":"user_id","value":"={{ $('Resolve Conversation').item.json.user_id }}"}]},"sort":{"values":[{"column":"name"}]